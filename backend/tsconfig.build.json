{
  "compilerOptions": {
    "target": "ES2017",
    "outDir": "./dist/backend",
    "rootDir": "./src",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
"exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma"]
}
